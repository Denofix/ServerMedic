# Set these locally. Never commit API keys. Both are required for AI analysis.
OPENAI_API_KEY=
# An OpenAI API model ID that supports Responses API + Structured Outputs.
# The model used to develop this project is a separate choice.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=6000
WEB_PORT=8080
# Hosted demo only: live inference requires a private access code (16–128 characters).
# Vercel enables PUBLIC_DEMO by default. Keep the code out of frontend variables and Git.
PUBLIC_DEMO=false
DEMO_ACCESS_CODE=
DEMO_REQUESTS_PER_MINUTE=5
DEMO_MAX_CONCURRENT=1
